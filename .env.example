# Copy to .env and fill in what you have. Every key is optional.

# --- LLM backend (stages 1-2: segmentation + query generation) --------------
# By DEFAULT the app uses your Claude subscription via the Claude Code CLI and
# NEVER the metered pay-per-token API. You don't need to set anything here for
# that — just be logged in to Claude Code (`claude` on PATH).
#
#   BROLL_LLM_BACKEND=auto          # default: subscription if `claude` CLI present, else offline
#   BROLL_LLM_BACKEND=subscription  # force the Claude Code CLI (your account)
#   BROLL_LLM_BACKEND=offline       # never call a model; rule-based fallback
#   BROLL_LLM_BACKEND=api           # OPT IN to the metered API (needs the key below)
BROLL_LLM_BACKEND=auto

# Only used when BROLL_LLM_BACKEND=api. Leave blank to guarantee the app never
# bills pay-per-token API usage.
ANTHROPIC_API_KEY=
BROLL_LLM_MODEL=claude-opus-4-8

# --- Source adapters --------------------------------------------------------
# Atmospheric sources
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Archival sources
SMITHSONIAN_API_KEY=
RIJKSMUSEUM_API_KEY=
DVIDS_API_KEY=

# Wikimedia, Met, LOC, Internet Archive, NASA, Openverse need no key.
